<?xml version="1.0" encoding="utf-8"?>
<!-- Going back: the screen underneath comes forward again, exactly reversing
     activity_open_exit so the gesture feels like an undo of the push. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/m3_emphasized"
    android:shareInterpolator="false">

    <translate
        android:fromXDelta="-33%p"
        android:toXDelta="0"
        android:duration="360"
        android:interpolator="@interpolator/m3_emphasized" />

    <scale
        android:fromXScale="0.94"
        android:toXScale="1.0"
        android:fromYScale="0.94"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="360"
        android:interpolator="@interpolator/m3_emphasized" />

    <alpha
        android:fromAlpha="0.6"
        android:toAlpha="1.0"
        android:duration="240"
        android:interpolator="@interpolator/m3_emphasized_decelerate" />
</set>
