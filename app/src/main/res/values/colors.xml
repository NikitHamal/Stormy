<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      XML colours are only used by things Compose cannot theme: the splash
      screen and the launcher icon background. Everything else reads from the
      Compose colour scheme in Color.kt, which is the single source of truth.

      Warm neutrals, matching the Compose palette exactly so the splash does
      not flash a different white before the app draws.
    -->
    <color name="codex_ink">#1C1917</color>
    <color name="codex_chalk">#FCFCFB</color>

    <color name="splash_background_light">#FCFCFB</color>
    <color name="splash_background_dark">#0C0B0A</color>
</resources>
