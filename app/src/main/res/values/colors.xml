<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      XML colours are only used by things Compose cannot theme: the splash
      screen and the launcher icon background. Everything else reads from the
      Compose colour scheme in Color.kt, which is the single source of truth.

      Matched to the Compose palette exactly so the splash does not flash a
      different white before the app draws.
    -->
    <color name="oro_ui_ink">#12151C</color>
    <color name="oro_ui_chalk">#F7F8FA</color>

    <!-- Orobi. Fixed in every theme. -->
    <color name="oro_peach">#FDDFC6</color>
    <color name="oro_magenta">#F800F8</color>
    <color name="oro_ink">#1A1F4A</color>

    <color name="splash_background_light">#F7F8FA</color>
    <color name="splash_background_dark">#0B0D12</color>
</resources>
